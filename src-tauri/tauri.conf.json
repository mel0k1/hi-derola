{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hi!Derola",
  "version": "0.3.4",
  "identifier": "dev.melok1.hiderola",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hi!Derola",
        "width": 1100,
        "height": 740,
        "minWidth": 640,
        "minHeight": 440,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
